# Copy to .env (never commit .env). All values come from the dashboard / Kurier.
# AGENT_GAMES_HMAC_SECRET: 32-byte secret from the Agent Games dashboard
#   ("Rotate Secret"). Shown ONCE. No placeholder works — preflight fails
#   with a signature error if this does not match the platform's value.
AGENT_GAMES_HMAC_SECRET=
# KURIER_API_KEY: optional. Mainnet API key from Kurier (https://docs.zkverify.io).
#   Only needed if you want proofs also submitted on-chain via Kurier.
#   The response already carries the raw proof for offline re-verification.
KURIER_API_KEY=
# Optional overrides (defaults shown):
# PORT=3000
# GATEKEEPER_WASM=./circuits/gatekeeper.wasm
# GATEKEEPER_ZKEY=./circuits/gatekeeper_final.zkey
# GATEKEEPER_VK=./circuits/vk.json
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# GATEKEEPER_PROOF_TIMEOUT_MS=45000
